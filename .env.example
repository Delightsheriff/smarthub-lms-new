# Copy to .env.local and fill in. Never commit real values.

# Base URL the browser calls. Dev: the Next proxy to the local API.
NEXT_PUBLIC_API_URL=http://localhost:3000/api-proxy
# API URL the server uses for sign-in (NextAuth credentials).
AUTH_API_URL=http://localhost:6001/api/v1
# NextAuth signing secret — generate with `npx auth secret`.
AUTH_SECRET=
# true behind a proxy / on Vercel.
AUTH_TRUST_HOST=true

# Optional — socket.io origin. Defaults to the API origin (dev: lib/api/dev-origin.ts).
NEXT_PUBLIC_SOCKET_URL=
# Optional — base for self-paced media URLs.
NEXT_PUBLIC_API_BASE_URL=
# Optional — public site origin used in share/referral links.
NEXT_PUBLIC_PUBLIC_CLIENT_URL=
